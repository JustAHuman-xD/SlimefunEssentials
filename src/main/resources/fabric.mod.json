{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "A Minecraft mod bringing new features and compatibility with the Slimefun4 Plugin!\nSupported Addons: Slimefun",
  "authors": [ "JustAHuman_xD" ],
  "contact": {
    "homepage": "https://modrinth.com/mod/slimefun-essentials",
    "sources": "https://github.com/JustAHuman-xD/SlimefunEssentials",
    "issues": "https://github.com/JustAHuman-xD/SlimefunEssentials/issues",
    "discord": "https://discord.gg/y6fV6pbgHB"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/y6fV6pbgHB"
      },
      "update_checker": true
    }
  },
  "license": "MIT",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.justahuman.slimefun_essentials.SlimefunEssentials"
    ],
    "modmenu": [
      "me.justahuman.slimefun_essentials.compat.modmenu.ModMenuIntegration"
    ],
    "jade": [
      "me.justahuman.slimefun_essentials.compat.jade.JadeIntegration"
    ],
    "emi": [
      "me.justahuman.slimefun_essentials.compat.emi.EmiIntegration"
    ],
    "jei_mod_plugin": [
      "me.justahuman.slimefun_essentials.compat.jei.JeiIntegration"
    ],
    "rei_client": [
      "me.justahuman.slimefun_essentials.compat.rei.ReiIntegration"
    ],
    "rei_common": [
      "me.justahuman.slimefun_essentials.compat.rei.ReiCommonIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version_range}"
  }
}
